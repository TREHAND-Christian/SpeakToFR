# window.py (REMPLACEMENT COMPLET)
import json
from pathlib import Path
from typing import Optional, List, Tuple

from PySide6.QtCore import Qt, QTimer, Slot, QSize
from PySide6.QtGui import QTextCursor, QTextCharFormat, QIcon
from PySide6.QtWidgets import (
    QWidget,
    QVBoxLayout,
    QTextEdit,
    QLabel,
    QToolBar,
    QToolButton,
    QComboBox,
    QSlider,
    QSizePolicy,
    QStyle,
    QMenu,
    QAction,
    QMessageBox,
)

from ..core.state import STATE
from ..core.tts_engine import (
    tts_pause,
    tts_resume,
    tts_stop,
    set_voice_by_index,
    get_speed_multiplier,
)
from .prefs import load_window_prefs, save_window_prefs


def _safe_float(v, default: float) -> float:
    try:
        return float(v)
    except Exception:
        return default


class ControlWindow(QWidget):
    """
    Fenêtre de contrôle (Windows-like) :
    - Toolbar Qt native (QToolBar) => rendu le plus proche de Windows
    - 2 petits boutons à droite (QToolButton autoRaise) style Windows (img1)
    - Pas de QSS "Fluent" ici : on laisse Qt/Windows faire le rendu natif.
    """

    def __init__(self, text_len: int, highlight_callback, cleanup_callback=None):
        super().__init__()
        self.setWindowTitle("SpeakToFR")
        self.setWindowFlags(Qt.WindowStaysOnTopHint | Qt.Window)  # Fenêtre native (pas frameless)
        self._highlight_callback = highlight_callback
        self._cleanup_callback = cleanup_callback

        self._highlight_timer = QTimer(self)
        self._highlight_timer.setSingleShot(True)
        self._highlight_timer.timeout.connect(self.apply_highlight_slot)

        # Etat de surbrillance
        self._last_highlight: Optional[Tuple[int, int]] = None  # (start, length)

        # Layout principal
        self._main_layout = QVBoxLayout(self)
        self._main_layout.setContentsMargins(8, 8, 8, 8)
        self._main_layout.setSpacing(8)

        # Toolbar (Windows natif)
        self.toolbar = QToolBar(self)
        self.toolbar.setMovable(False)
        self.toolbar.setFloatable(False)
        self.toolbar.setToolButtonStyle(Qt.ToolButtonTextBesideIcon)
        self.toolbar.setIconSize(QSize(16, 16))

        st = self.style()

        # --- Boutons principaux (toolbar) ---
        self.pause_icon = st.standardIcon(QStyle.SP_MediaPause)
        self.play_icon = st.standardIcon(QStyle.SP_MediaPlay)
        self.stop_icon = st.standardIcon(QStyle.SP_MediaStop)
        self.close_icon = st.standardIcon(QStyle.SP_DialogCloseButton)

        # Pause
        self.btn_pause = QToolButton(self)
        self.btn_pause.setToolButtonStyle(Qt.ToolButtonTextBesideIcon)
        self.btn_pause.setIcon(self.pause_icon)
        self.btn_pause.setText("Pause")
        self.btn_pause.setToolTip("Pause / Reprendre")
        self.btn_pause.clicked.connect(self.on_pause_clicked)
        self.toolbar.addWidget(self.btn_pause)

        self.toolbar.addSeparator()

        # Stop
        self.btn_stop = QToolButton(self)
        self.btn_stop.setToolButtonStyle(Qt.ToolButtonTextBesideIcon)
        self.btn_stop.setIcon(self.stop_icon)
        self.btn_stop.setText("Stop")
        self.btn_stop.setToolTip("Arrêter la lecture")
        self.btn_stop.clicked.connect(self.on_stop_clicked)
        self.toolbar.addWidget(self.btn_stop)

        self.toolbar.addSeparator()

        # Fermer
        self.btn_close = QToolButton(self)
        self.btn_close.setToolButtonStyle(Qt.ToolButtonTextBesideIcon)
        self.btn_close.setIcon(self.close_icon)
        self.btn_close.setText("Fermer")
        self.btn_close.setToolTip("Fermer la fenêtre")
        self.btn_close.clicked.connect(self.close)
        self.toolbar.addWidget(self.btn_close)

        self.toolbar.addSeparator()

        # Voix
        self.toolbar.addWidget(QLabel("Voix"))
        self.voice_combo = QComboBox(self)
        self.voice_combo.setMinimumWidth(200)
        self.voice_combo.currentIndexChanged.connect(self.on_voice_changed)
        self.toolbar.addWidget(self.voice_combo)

        self.toolbar.addSeparator()

        # Vitesse
        self.speed_label = QLabel("Vitesse 1.0", self)
        self.toolbar.addWidget(self.speed_label)

        self.speed_slider = QSlider(Qt.Horizontal, self)
        self.speed_slider.setRange(50, 200)     # 0.5x -> 2.0x
        self.speed_slider.setValue(100)         # 1.0x
        self.speed_slider.setFixedWidth(260)
        self.speed_slider.valueChanged.connect(self.on_speed_changed)
        self.toolbar.addWidget(self.speed_slider)

        self.toolbar.addSeparator()

        # Navigation (comme groupe de boutons à droite sur ta barre)
        nav_size = QSize(28, 28)

        self.btn_first = QToolButton(self)
        self.btn_first.setAutoRaise(True)
        self.btn_first.setFixedSize(nav_size)
        self.btn_first.setIcon(st.standardIcon(QStyle.SP_MediaSkipBackward))
        self.btn_first.setToolTip("Première phrase")
        self.btn_first.clicked.connect(lambda: self._jump_to_sentence(0))
        self.toolbar.addWidget(self.btn_first)

        self.btn_prev = QToolButton(self)
        self.btn_prev.setAutoRaise(True)
        self.btn_prev.setFixedSize(nav_size)
        self.btn_prev.setIcon(st.standardIcon(QStyle.SP_MediaSeekBackward))
        self.btn_prev.setToolTip("Phrase précédente")
        self.btn_prev.clicked.connect(lambda: self._jump_to_sentence(max(0, getattr(STATE, "sentence_index", 0) - 1)))
        self.toolbar.addWidget(self.btn_prev)

        self.btn_next = QToolButton(self)
        self.btn_next.setAutoRaise(True)
        self.btn_next.setFixedSize(nav_size)
        self.btn_next.setIcon(st.standardIcon(QStyle.SP_MediaSeekForward))
        self.btn_next.setToolTip("Phrase suivante")
        self.btn_next.clicked.connect(lambda: self._jump_to_sentence(getattr(STATE, "sentence_index", 0) + 1))
        self.toolbar.addWidget(self.btn_next)

        self.btn_last = QToolButton(self)
        self.btn_last.setAutoRaise(True)
        self.btn_last.setFixedSize(nav_size)
        self.btn_last.setIcon(st.standardIcon(QStyle.SP_MediaSkipForward))
        self.btn_last.setToolTip("Dernière phrase")
        self.btn_last.clicked.connect(lambda: self._jump_to_sentence(10**9))
        self.toolbar.addWidget(self.btn_last)

        # Spacer pour pousser les 2 petits boutons tout à droite
        spacer = QWidget(self)
        spacer.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Preferred)
        self.toolbar.addWidget(spacer)

        # === 2 petits boutons fin (img1), style Windows natif ===
        self.btn_quick_play = QToolButton(self)
        self.btn_quick_play.setAutoRaise(True)
        self.btn_quick_play.setToolButtonStyle(Qt.ToolButtonIconOnly)
        self.btn_quick_play.setFixedSize(nav_size)
        self.btn_quick_play.setIcon(self.pause_icon)
        self.btn_quick_play.setToolTip("Lire / Pause")
        self.btn_quick_play.clicked.connect(self.on_pause_clicked)
        self.toolbar.addWidget(self.btn_quick_play)

        self.btn_quick_menu = QToolButton(self)
        self.btn_quick_menu.setAutoRaise(True)
        self.btn_quick_menu.setToolButtonStyle(Qt.ToolButtonIconOnly)
        self.btn_quick_menu.setFixedSize(nav_size)
        self.btn_quick_menu.setArrowType(Qt.DownArrow)
        self.btn_quick_menu.setToolTip("Menu")
        self.toolbar.addWidget(self.btn_quick_menu)

        menu = QMenu(self)
        act_prefs = QAction("Préférences…", self)
        act_about = QAction("À propos…", self)
        act_quit = QAction("Quitter", self)

        act_prefs.triggered.connect(self._show_prefs_placeholder)
        act_about.triggered.connect(self._show_about_placeholder)
        act_quit.triggered.connect(self.close)

        menu.addAction(act_prefs)
        menu.addAction(act_about)
        menu.addSeparator()
        menu.addAction(act_quit)

        self.btn_quick_menu.setMenu(menu)
        self.btn_quick_menu.setPopupMode(QToolButton.InstantPopup)

        # Ajout toolbar au layout
        self._main_layout.addWidget(self.toolbar)

        # Zone texte
        self.info_label = QLabel("", self)
        self.info_label.setWordWrap(True)
        self._main_layout.addWidget(self.info_label)

        self.text_edit = QTextEdit(self)
        self.text_edit.setReadOnly(True)
        self.text_edit.setAcceptRichText(True)
        self.text_edit.setMinimumHeight(220)
        self._main_layout.addWidget(self.text_edit, 1)

        # Applique prefs (position)
        self._apply_saved_position()

    # ---------------- UI callbacks ----------------

    def _show_prefs_placeholder(self):
        QMessageBox.information(self, "SpeakToFR", "Préférences… (placeholder)")

    def _show_about_placeholder(self):
        QMessageBox.information(self, "SpeakToFR", "SpeakToFR\nUI: PySide6 (Windows native style)")

    @Slot()
    def on_pause_clicked(self):
        try:
            if not getattr(STATE, "paused", False):
                # Passer en pause
                try:
                    tts_pause()
                except Exception:
                    pass
                STATE.paused = True
                self.btn_pause.setText("Reprendre")
                self.btn_pause.setIcon(self.play_icon)
            else:
                # Reprendre
                try:
                    tts_resume()
                except Exception:
                    pass
                STATE.paused = False
                self.btn_pause.setText("Pause")
                self.btn_pause.setIcon(self.pause_icon)
        finally:
            # Sync petit bouton de fin
            try:
                self.btn_quick_play.setIcon(self.play_icon if getattr(STATE, "paused", False) else self.pause_icon)
            except Exception:
                pass

    @Slot()
    def on_stop_clicked(self):
        try:
            tts_stop()
        except Exception:
            pass
        try:
            STATE.paused = False
        except Exception:
            pass
        self.btn_pause.setText("Pause")
        self.btn_pause.setIcon(self.pause_icon)
        try:
            self.btn_quick_play.setIcon(self.pause_icon)
        except Exception:
            pass

    @Slot(int)
    def on_voice_changed(self, index: int):
        try:
            set_voice_by_index(index)
            # garde une trace
            if 0 <= index < len(getattr(STATE, "voices", [])):
                STATE.current_voice_desc = STATE.voices[index]["desc"]
        except Exception:
            pass

    @Slot(int)
    def on_speed_changed(self, value: int):
        # value: 50..200 => 0.5..2.0
        speed = value / 100.0
        self.speed_label.setText(f"Vitesse {speed:.1f}")
        try:
            STATE.speed = speed
        except Exception:
            pass

    # ---------------- Navigation / highlight ----------------

    def _jump_to_sentence(self, idx: int):
        """
        Délègue à highlight_callback : c’est lui qui sait se replacer dans le texte et relancer la lecture.
        """
        try:
            self._highlight_callback(idx)
        except Exception:
            pass

    @Slot()
    def apply_highlight_slot(self):
        # Compat : appelée via QTimer (si l’app l’utilise)
        if self._last_highlight is None:
            return
        start, length = self._last_highlight
        self.apply_highlight(start, length)

    def set_voice_items(self, items: List[str], current_desc: Optional[str] = None):
        self.voice_combo.blockSignals(True)
        self.voice_combo.clear()
        self.voice_combo.addItems(items or [])
        if current_desc and current_desc in items:
            self.voice_combo.setCurrentIndex(items.index(current_desc))
        self.voice_combo.blockSignals(False)

    def set_info(self, text: str):
        self.info_label.setText(text or "")

    def set_content(self, html_or_text: str, is_html: bool = True):
        # Le code appelant peut envoyer du HTML.
        if is_html:
            self.text_edit.setHtml(html_or_text or "")
        else:
            self.text_edit.setPlainText(html_or_text or "")

    def apply_highlight(self, start: int, length: int):
        """
        Surbrillance simple dans QTextEdit (sans thème custom).
        """
        if start < 0 or length <= 0:
            return

        self.clear_highlight()

        cursor = self.text_edit.textCursor()
        cursor.setPosition(0)
        cursor.movePosition(QTextCursor.Right, QTextCursor.MoveAnchor, start)
        cursor.movePosition(QTextCursor.Right, QTextCursor.KeepAnchor, length)

        fmt = QTextCharFormat()
        # Highlight natif-ish : on laisse Qt choisir une couleur proche
        # (pas de QColor imposée, ça reste Windows-like)
        fmt.setBackground(self.palette().highlight())
        fmt.setForeground(self.palette().highlightedText())

        cursor.mergeCharFormat(fmt)
        self.text_edit.setTextCursor(cursor)
        self._last_highlight = (start, length)

    def clear_highlight(self):
        """
        Retire la surbrillance (reset format).
        """
        try:
            cursor = self.text_edit.textCursor()
            cursor.select(QTextCursor.Document)
            fmt = QTextCharFormat()
            cursor.setCharFormat(fmt)
        except Exception:
            pass
        self._last_highlight = None

    def shrink_text_area(self):
        """
        Compat : si ton code appelait cette méthode.
        Ici on réduit juste la hauteur mini.
        """
        self.text_edit.setMinimumHeight(160)

    # ---------------- Prefs / events ----------------

    def closeEvent(self, event):
        try:
            prefs = load_window_prefs() or {}
            prefs["x"] = int(self.x())
            prefs["y"] = int(self.y())
            prefs["w"] = int(self.width())
            prefs["h"] = int(self.height())
            save_window_prefs(prefs)
        except Exception:
            pass

        try:
            if callable(self._cleanup_callback):
                self._cleanup_callback()
        except Exception:
            pass

        super().closeEvent(event)

    def moveEvent(self, event):
        # Sauvegarde légère (optionnelle)
        super().moveEvent(event)

    def _apply_saved_position(self):
        try:
            prefs = load_window_prefs() or {}
            x = prefs.get("x")
            y = prefs.get("y")
            w = prefs.get("w")
            h = prefs.get("h")
            if isinstance(w, int) and isinstance(h, int) and w > 200 and h > 150:
                self.resize(w, h)
            if isinstance(x, int) and isinstance(y, int):
                self.move(x, y)
        except Exception:
            pass
